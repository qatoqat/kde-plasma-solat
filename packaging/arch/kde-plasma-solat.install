post_install() {
    echo ">>> Right-click a panel → Add Widgets → 'Waktu Solat', then pick your zone"
    echo ">>> in the widget's settings. To show it on the lock screen, tick"
    echo ">>> 'Show prayer times on the lock screen' there."
}

post_upgrade() {
    echo ">>> Restart the shell to load the new version:"
    echo ">>>   systemctl --user restart plasma-plasmashell.service"
}

pre_remove() {
    echo ">>> If the lock screen uses Waktu Solat, switch it back first:"
    echo ">>>   kwriteconfig6 --file kscreenlockerrc --group Greeter --key WallpaperPlugin org.kde.image"
}
