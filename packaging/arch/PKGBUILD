# Maintainer: Qatoqat <39856402+qatoqat@users.noreply.github.com>
pkgname=kde-plasma-solat
pkgver=0.3.4
pkgrel=1
pkgdesc="JAKIM (e-solat.gov.my) prayer times for KDE Plasma: panel widget with check-offs and reminders, and a lock screen"
arch=('any')
url="https://github.com/qatoqat/kde-plasma-solat"
license=('GPL-2.0-or-later')
depends=('plasma-workspace' 'libplasma' 'kirigami' 'knotifications' 'kconfig' 'kscreenlocker' 'plasma5support' 'qt6-declarative')
conflicts=('solat-lock')
replaces=('solat-lock')
install=kde-plasma-solat.install
source=("git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

package() {
    cd "$pkgname"

    local widget="$pkgdir/usr/share/plasma/plasmoids/solat.widget"
    install -Dm644 widget/metadata.json -t "$widget/"
    install -Dm644 widget/contents/config/* -t "$widget/contents/config/"
    install -Dm644 widget/contents/ui/* -t "$widget/contents/ui/"
    install -Dm644 widget/contents/code/* -t "$widget/contents/code/"
    install -Dm644 widget/contents/images/* -t "$widget/contents/images/"
    install -Dm644 icons/kde-plasma-solat.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"

    local plugin="$pkgdir/usr/share/plasma/wallpapers/solat.lockscreen"
    install -Dm644 plasma/metadata.json -t "$plugin/"
    install -Dm644 plasma/contents/config/* -t "$plugin/contents/config/"
    install -Dm644 plasma/contents/ui/* -t "$plugin/contents/ui/"

    install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
